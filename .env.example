# CertiFoto — variables de entorno (todas opcionales)
# Copia este archivo a .env.local y descomenta lo que necesites.
# .env.local esta en .gitignore — nunca lo commitees.

# === Analytics ===
# Vercel Analytics es automatico en deploys de Vercel.
# Si quieres analytics en otro hosting, descomenta:
# NEXT_PUBLIC_ANALYTICS_ID=

# === URL canonica del sitio ===
# Por defecto se infiere. Util para SEO en sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://certifoto.cl

#=== IA Vision (opcional, recomendado) ===
# Habilita la clasificacion automatica de ambientes en /api/classify-room.
# Cuando se sube un lote de fotos, la IA mira cada imagen y propone a que
# ambiente del acta pertenece. Sin esta variable, el sistema cae a la
# heuristica de nombre de archivo y asignacion manual.
#
# Modelo: claude-haiku-4-5 (Anthropic) — costo ~$0.001 USD por foto.
# Token: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# === Supabase (auth con magic link, creditos y respaldo de actas) ===
# Proyecto compartido de Expansiel ("supabase-expansiel-landing"), namespace cf_*.
# URL y publishable key son publicas; tienen fallback en lib/supabase/env.ts.
# NEXT_PUBLIC_SUPABASE_URL=https://alksowkwsnjeesmnosvg.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Login por magic link: el token lo genera la Edge Function cf-magic-link
# DENTRO de Supabase (la service role key del proyecto compartido nunca sale
# de ahi; CertiFoto NO la tiene) y el correo lo ENVIA LISTMONK. Por eso no hay
# que configurar SMTP, plantillas ni redirect URLs en el dashboard.
# CERTIFOTO_LINK_SECRET: secreto acotado con el que CertiFoto llama a la
# funcion (solo sirve para "pedir un enlace para el correo X"). En la base vive
# solo su sha256 (cf_config). Generado a archivo, nunca por chat. SOLO servidor.
# CERTIFOTO_LINK_SECRET=
#
# Anti-abuso del magic link (obligatorio antes de apuntar Supabase Auth a SES:
# un bot puede hacer enviar correos a direcciones inventadas y los rebotes
# danan la reputacion SES compartida). Site key publica de Cloudflare Turnstile;
# la secret key va en Supabase > Authentication > Bot and Abuse Protection.
# Sin site key, el formulario funciona sin CAPTCHA (util en local). La secret
# la verifica /api/auth/solicitar contra Cloudflare. Aun sin CAPTCHA hay
# honeypot y rate limit (3 por correo / 15 min, 10 por IP / hora) en la base.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# === Pagos con Flow (flow.cl): compra de packs de creditos ===
# Claves de PRODUCCION cargadas en Vercel por CLI (nunca en el repo ni en chat).
# Flujo: /api/pagos/flow/crear -> redirige a Flow -> webhook
# /api/pagos/flow/confirmar (+ retorno /pagos/flow/retorno) -> cf_pago_confirmar
# abona los creditos una sola vez (idempotente por orden).
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
# FLOW_API_URL=https://www.flow.cl/api        sandbox: https://sandbox.flow.cl/api
# CERTIFOTO_PAGOS_SECRET=                     secreto acotado (sha256 en cf_config) para las RPC cf_pago_*

# === Avisos por correo: contacto, packs y leads ===
# lib/correo.ts manda avisos a LEAD_NOTIFY_EMAIL via Listmonk (infra de correo
# compartida de Expansiel en AWS + SES). Lo usan /api/contacto (formulario y
# solicitudes de pack: exito solo si el aviso fue aceptado) y /api/lead
# (plantilla PDF: la descarga nunca se bloquea).
# En Vercel Production ya estan cargadas. El token vive solo en Vercel.
# LISTMONK_URL=https://listmonk.expansiel.com
# LISTMONK_API_USER=certifoto_api
# LISTMONK_API_TOKEN=
# LISTMONK_TX_TEMPLATE=6                 Plantilla "pasamanos": {{ .Tx.Data.cuerpo | Safe }}
# LEAD_NOTIFY_EMAIL=emilio@expansiel.com A donde llegan los avisos
# LEAD_FROM=CertiFoto <hola@certifoto.cl>  Remitente (dominio verificado en SES)
#
# Alternativas para /api/lead si Listmonk no esta configurado:
# Opcion A — Web3Forms (gratis, sin backend):
#   Crea una access key en https://web3forms.com (30 seg) y pega aqui.
# WEB3FORMS_ACCESS_KEY=
#
# Opcion B — Resend (requiere dominio verificado):
# RESEND_API_KEY=
# LEAD_NOTIFY_EMAIL=                 A donde llegan los leads (requerido con Resend)
# LEAD_FROM=CertiFoto <onboarding@resend.dev>

# === Servicios futuros (no requeridos hoy) ===
# SENTRY_DSN=                       Error tracking
